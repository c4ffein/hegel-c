  * Scatterlist splitting helpers.
+ *
+ * This is the proposed v2 state of lib/sg_split.c, PLUS the tier-1 tolerate fix for
+ * bug 4 (comparison variant for the v3 cover letter):
+ *
+ *   patch 1 — sg_calculate_split() nb_splits overshoot: break on <= 0
+ *             (was `if (!nb_splits)`, missed the decrement to -1).
+ *   patch 2 — sg_split_phys() ->length clobber (bug C): write ->length
+ *             AFTER `sg_dma_len(out_sg) = 0`, so on !NEED_SG_DMA_LENGTH
+ *             arches (where sg_dma_len aliases ->length) the length the
+ *             loop just computed is not wiped.
+ *   patch 4 — zero-nents OOB guard in BOTH copiers: a split that covers
+ *             no input entry must not run `out_sg[-1] = ...` against a
+ *             zero-size (ZERO_SIZE_PTR) buffer.
  */
 
 #include <linux/scatterlist.h>
@@ -67,11 +81,16 @@
 			size = *(++sizes);
 		}
 
-		if (!nb_splits)
+		if (nb_splits <= 0)		/* patch 1: was `if (!nb_splits)` */
 			break;
 	}
 
-	return (size || !splitters[0].in_sg0) ? -EINVAL : 0;
+	if (size || !splitters[0].in_sg0)
+		return -EINVAL;
+	while (--nb_splits > 0)		/* bug 4: unconsumed sizes must all */
+		if (*(++sizes))		/* be zero, else under-coverage was */
+			return -EINVAL;	/* silently accepted */
+	return 0;
 }
 
