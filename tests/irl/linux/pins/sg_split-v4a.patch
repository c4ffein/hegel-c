Our sg_split candidate v4a = v3 + bug-5 fix guarded by skip != 0
(skip && skip >= sglen).  The only variant green on the full contract
(make ladder / make acid).

Against lib/sg_split.c at v7.1 (same file as the v2 series base 08d0d3466664).
Made from the former vendored tests/irl/linux/sg_split/sg_split_v4a.c; the
sg_split harness Makefile applies it (patch -o) to build that variant.

--- a/lib/sg_split.c
+++ b/lib/sg_split.c
@@ -1,8 +1,23 @@
 // SPDX-License-Identifier: GPL-2.0-only
 /*
  * Copyright (C) 2015 Robert Jarzmik <robert.jarzmik@free.fr>
+ * Copyright (C) 2026 Charles Pellegrini <c4ffein.work@gmail.com>
  *
  * Scatterlist splitting helpers.
+ *
+ * CANDIDATE v4a = v3 + patch 6 (`skip && skip >= sglen`).  Inherited:
+ *
+ *   patch 1 — sg_calculate_split() nb_splits overshoot: break on <= 0.
+ *   patch 2 — sg_split_phys() ->length clobber: write ->length AFTER
+ *             the `sg_dma_len(out_sg) = 0` scrub.
+ *   patch 4 (v3) — reject zero-size splits with -EINVAL upfront.  This
+ *             supersedes v2's zero-nents copier guards: with every
+ *             split size >= 1, any split reaching the copiers on the
+ *             success path has consumed at least one byte, so
+ *             nents >= 1 and the out_sg[-1] fixups are always in
+ *             bounds.  It also closes the zero-at-exhaustion silent
+ *             success (bug 4): the only loop exit with size == 0 and
+ *             splits remaining required loading a zero size.
  */
 
 #include <linux/scatterlist.h>
@@ -34,7 +49,12 @@
 
 	for_each_sg(in, sg, nents, i) {
 		sglen = mapped ? sg_dma_len(sg) : sg->length;
-		if (skip > sglen) {
+		/* patch 6: consume an entry the skip fully covers, INCLUDING the
+		** exact-boundary case skip == sglen (bug 5).  Guarded by skip != 0:
+		** the copiers rebuild each split by walking sg_next() nents times
+		** from in_sg0, so entries may only be dropped BEFORE in_sg0 is
+		** established -- skipping one mid-split desynchronises the walk. */
+		if (skip && skip >= sglen) {
 			skip -= sglen;
 			continue;
 		}
@@ -67,7 +87,7 @@
 			size = *(++sizes);
 		}
 
-		if (!nb_splits)
+		if (nb_splits <= 0)		/* patch 1: was `if (!nb_splits)` */
 			break;
 	}
 
@@ -84,13 +104,16 @@
 		in_sg = split->in_sg0;
 		out_sg = split->out_sg;
 		for (j = 0; j < split->nents; j++, out_sg++) {
+			unsigned int len = in_sg->length;
+
 			*out_sg = *in_sg;
+			sg_dma_address(out_sg) = 0;
+			sg_dma_len(out_sg) = 0;
 			if (!j) {
 				out_sg->offset += split->skip_sg0;
-				out_sg->length -= split->skip_sg0;
+				len -= split->skip_sg0;
 			}
-			sg_dma_address(out_sg) = 0;
-			sg_dma_len(out_sg) = 0;
+			out_sg->length = len;	/* patch 2: AFTER sg_dma_len=0 */
 			in_sg = sg_next(in_sg);
 		}
 		out_sg[-1].length = split->length_last_sg;
@@ -152,6 +175,10 @@
 	int i, ret;
 	struct sg_splitter *splitters;
 
+	for (i = 0; i < nb_splits; i++)
+		if (!split_sizes[i])
+			return -EINVAL;	/* patch 4 (v3): zero-size split */
+
 	splitters = kzalloc_objs(*splitters, nb_splits, gfp_mask);
 	if (!splitters)
 		return -ENOMEM;
